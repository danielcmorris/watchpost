{
  "name": "watchpost-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "node-pg-migrate -m migrations --migration-file-language sql",
    "test": "vitest run"
  },
  "dependencies": {
