# Copy to .env and fill in. Never commit .env.

# --- Required ---------------------------------------------------------------
# Postgres connection string. With the bundled database (docker compose
# --profile with-db) use host "db" and the POSTGRES_* values below.
DATABASE_URL=postgres://watchpost:CHANGE_ME@db:5432/watchpost
# Random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=
# Admin account, created on first start only (when no users exist).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Bundled database (only used with --profile with-db) --------------------
POSTGRES_USER=watchpost
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=watchpost

# --- Public URL / port ------------------------------------------------------
# The URL users reach the app at. An https:// URL turns on Secure cookies.
PUBLIC_URL=http://localhost:4250
# Port published on the Docker host
HOST_PORT=4250

# --- Email alerts (optional; without these, alerts are only logged) ---------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER if blank
SMTP_FROM=
